<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\images\branding\logo_coffee_cup.png" />
    <None Remove="assets\images\drinks\default_drink.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lucide.NET.Wpf" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoffeeLoyalty.Core\CoffeeLoyalty.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\images\branding\logo_coffee_cup.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="assets\images\drinks\default_drink.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
